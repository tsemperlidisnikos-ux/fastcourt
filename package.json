{
  "name": "fastcourt-next",
  "version": "0.1.0",
  "description": "FastCourt — tactical basketball play designer",
  "author": "FastCourt",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "dev:turbo": "next dev --turbopack",
    "build": "node scripts/generate-sw.mjs && next build",
    "postinstall": "node scripts/copy-pdf-worker.mjs && node scripts/generate-sw.mjs",
    "start": "next start",
    "start:plesk": "node server.js",
    "lint": "eslint",
    "test": "node scripts/health-check.mjs",
    "test:unit": "npx tsx --test scripts/tests/*.test.ts",
    "health-check": "node scripts/health-check.mjs",
    "health-check:full": "node scripts/health-check.mjs --lint --build --json=reports/health-check-report.json",
    "app-check": "node scripts/full-app-check.mjs --skip-build",
    "app-check:full": "node scripts/full-app-check.mjs",
    "app-check:e2e": "npx playwright test",
    "production-smoke": "node scripts/production-smoke.mjs",
    "qa:checklists": "node scripts/generate-qa-checklists.mjs",
    "link-team-library": "node scripts/link-team-library.mjs",
    "backup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/backup.ps1",
    "render:intro": "node scripts/render-intro-video.mjs",
    "render:intro:preview": "node scripts/render-intro-video.mjs --preview",
    "create-admin": "node scripts/create-admin.mjs",
    "setup:supabase": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-supabase-production.ps1",
    "supabase:schema": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-supabase-schema.ps1",
    "electron:dev": "electron electron/main.js",
    "electron:pack": "electron-builder --win portable",
    "electron:dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "eu.fastcourt.desktop",
    "productName": "FastCourt",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "public/icons/fastcourt-logo.png",
      "public/assets/landing/fastcourt-intro-mark.png"
    ],
    "asar": true,
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "public/assets/landing/fastcourt-intro-mark.png"
    },
    "portable": {
      "artifactName": "FastCourt-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "FastCourt-${version}-setup.exe"
    }
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.1",
    "html2canvas": "^1.4.1",
    "idb": "^8.0.3",
    "konva": "^10.3.0",
    "lz-string": "^1.5.0",
    "mp4-muxer": "^5.2.2",
    "next": "16.2.9",
    "pdfjs-dist": "^6.0.227",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-konva": "^19.2.5",
    "stripe": "^22.2.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@playwright/test": "^1.52.0",
    "@tailwindcss/postcss": "^4",
    "@types/lz-string": "^1.3.34",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^35.7.5",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "tsx": "^4.20.3",
    "typescript": "^5"
  }
}
