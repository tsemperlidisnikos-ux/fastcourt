# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/reports/
/playwright-report/
/test-results/
health-check-report.json
project-analysis.json
lint-report.json

# next.js
/.next/
/out/

# production
/build
/dist-electron
/dist-usb

# misc
scripts/tmp-*
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel / netlify
.vercel
.netlify

# local debug logs
*.log
tailwindcss-*.log
netlify_deploy_debug.log

# typescript
*.tsbuildinfo
next-env.d.ts
