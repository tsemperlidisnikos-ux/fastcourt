# FastCourt Next - copy to .env.local for optional cloud mode
# Local-only mode works without these variables.

# Supabase (cloud auth + sync)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Supabase service role (server-only — Stripe webhook, admin profile sync)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Stripe (production billing webhook)
STRIPE_SECRET_KEY=sk_test_YOUR_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET

# OpenAI — Film Room "Analyze clip" (vision). Server-only.
OPENAI_API_KEY=sk-YOUR_KEY
# Optional override (default: gpt-4o-mini)
# OPENAI_VISION_MODEL=gpt-4o-mini

# App metadata
NEXT_PUBLIC_APP_BUILD=next-v8
NEXT_PUBLIC_ADMIN_EMAIL=admin@fastcourt.eu
NEXT_PUBLIC_MASTER_ADMIN_EMAIL=admin@fastcourt.eu
# Comma-separated emails that become master admin on signup
NEXT_PUBLIC_ADMIN_EMAILS=admin@fastcourt.eu
