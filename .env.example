# FastCourt Next - copy to .env.local for optional cloud mode
# Local-only mode works without these variables.

# Supabase (cloud auth + sync)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# App metadata
NEXT_PUBLIC_APP_BUILD=next-v7
NEXT_PUBLIC_ADMIN_EMAIL=admin@fastcourt.eu
NEXT_PUBLIC_MASTER_ADMIN_EMAIL=admin@fastcourt.eu
